---
// src/components/Footer.astro
---
<footer class="bg-[#333333] text-white pt-16 pb-8 border-t-[8px] border-[#e66c37]">
  <div class="max-w-[1400px] mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-8">
    <div>
      <div class="bg-white inline-block py-3 px-5 rounded-xl shadow-lg mb-8">
        <img src="/logo-lucong.png" alt="Lucong" class="h-12 md:h-14 w-auto object-contain" />
      </div>
      <p class="text-sm text-slate-300 font-medium mb-4">Construimos oportunidades para todos de manera sostenible.</p>
      <p class="text-sm text-slate-400">Lucong Contratistas Generales S.A.<br/>RUC 20000000000<br/>Lima - Perú</p>
    </div>
    <div>
      <h4 class="text-lg font-bold mb-4">Menú Principal</h4>
      <ul class="space-y-2 text-sm text-slate-300">
        <li><a href="#" class="hover:text-white transition">Nosotros</a></li>
        <li><a href="#" class="hover:text-white transition">Proyectos</a></li>
        <li><a href="#" class="hover:text-white transition">Servicios</a></li>
        <li><a href="#" class="hover:text-white transition">Ética y Cumplimiento</a></li>
      </ul>
    </div>
    <div>
      <h4 class="text-lg font-bold mb-4">Contáctanos</h4>
      <div class="flex items-center gap-3 text-lg font-bold text-blue-300 bg-blue-900/30 w-fit px-4 py-2 rounded-full mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.48-4.18-7.076-7.076l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
        (511) 600 0000
      </div>
    </div>
    <div>
      <h4 class="text-lg font-bold mb-4">Certificaciones</h4>
      <div class="flex gap-2">
        <div class="w-16 h-16 bg-slate-100 rounded-lg opacity-80"></div>
        <div class="w-16 h-16 bg-slate-100 rounded-lg opacity-80"></div>
        <div class="w-16 h-16 bg-slate-100 rounded-lg opacity-80"></div>
      </div>
    </div>
  </div>
</footer>