      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-slate-100 absolute w-full left-0 shadow-2xl">
    <nav class="flex flex-col px-6 py-6 space-y-4 text-[16px] text-[#333333] font-medium">
      <a href="/nosotros" class="hover:text-[#e66c37] transition-colors py-3 border-b border-slate-100">Nosotros</a>
      <a href="/proyectos" class="hover:text-[#e66c37] transition-colors py-3 border-b border-slate-100">Proyectos</a>
