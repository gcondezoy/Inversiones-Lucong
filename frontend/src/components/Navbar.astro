---
// src/components/Navbar.astro
---

<header class="w-full bg-white shadow-md sticky top-0 z-50">
  <div class="max-w-[1200px] mx-auto px-6 md:px-8 flex items-center justify-between h-24 md:h-28 relative">
    
    <a href="/" class="flex-shrink-0 animate-drop-down flex items-center h-full py-2" style="animation-delay: 0s;">
      <img src="/logo-lucong.png" alt="Lucong Logo" class="h-16 md:h-[90px] w-auto object-contain" />
    </a>

    <nav class="hidden lg:flex items-center space-x-8 text-[15px] text-[#333333] font-medium h-full">
      <a href="/nosotros" class="hover:text-[#e66c37] transition-colors h-full flex items-center">Nosotros</a>
      <a href="/proyectos" class="hover:text-[#e66c37] transition-colors h-full flex items-center">Proyectos</a>
      <a href="/servicios" class="hover:text-[#e66c37] transition-colors h-full flex items-center">Servicios</a>
      <a href="/etica-y-cumplimiento" class="hover:text-[#e66c37] transition-colors h-full flex items-center">Ética y cumplimiento</a>
    </nav>

    <div class="hidden lg:flex items-center space-x-5 animate-drop-down" style="animation-delay: 0.6s;">
      <a href="#" target="_blank" aria-label="Facebook" class="text-slate-400 hover:text-[#e66c37] transition-colors">
