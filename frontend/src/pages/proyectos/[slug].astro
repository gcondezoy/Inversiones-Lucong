---
// src/pages/proyectos/[slug].astro
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

// 1. ASTRO GENERA LAS RUTAS AUTOMÁTICAMENTE CON ESTA FUNCIÓN
export async function getStaticPaths() {
  const proyectos = [
    { 
      slug: 'residencial-los-alamos', 
      mainCat: 'Residencial', 
      title: 'Edificio Residencial Los Alamos', 
      img: 'https://images.unsplash.com/photo-1545324418-cc1a3fa10c00', 
      status: 'En ejecución',
      cliente: 'Inmobiliaria Los Alamos SAC',
      ubicacion: 'San Isidro, Lima',
      descripcion: 'Construcción integral de un edificio residencial de 15 pisos con 4 niveles de sótanos. El proyecto incluye acabados de lujo, áreas comunes, piscina en la azotea y un sistema de automatización inteligente (Smart Home). Se están aplicando estándares de construcción sostenible para certificación LEED.'
    },
    { 
      slug: 'planta-acero', 
      mainCat: 'Industrial', 
      title: 'Planta de Procesamiento de Acero', 
      img: 'https://images.unsplash.com/photo-1565463299128-95d8208a0d0d', 
      status: 'Completado',
      cliente: 'Aceros del Sur S.A.',
      ubicacion: 'Chilca, Lima',
      descripcion: 'Desarrollo y montaje electromecánico de la nueva planta de procesamiento siderúrgico. La obra civil contempló losas de cimentación masiva para maquinaria pesada, naves industriales de estructura metálica y sistemas de drenaje especial para fluidos industriales.'
    },
    { 
      slug: 'centro-comercial-miraflores', 
      mainCat: 'Comercial', 
      title: 'Centro Comercial Miraflores', 
      img: 'https://images.unsplash.com/photo-1562664376-7fb640b8b8ce', 
      status: 'En ejecución',
      cliente: 'Retail Group Perú',
      ubicacion: 'Miraflores, Lima',
      descripcion: 'Ampliación y remodelación de 12,000 m2 de área comercial útil. Incluye la construcción de nuevos locales ancla, patio de comidas, reforzamiento estructural del edificio existente y modernización de las fachadas con paneles de aluminio compuesto (ACM) y muros cortina.'
    },
    { 
      slug: 'puente-rio-verde', 
      mainCat: 'Infraestructura', 
      title: 'Puente Vehicular Rio Verde', 
      img: 'https://images.unsplash.com/photo-1581092160607-ee22530dd83a', 
      status: 'Completado',
      cliente: 'Ministerio de Transportes y Comunicaciones',
      ubicacion: 'Región San Martín',
      descripcion: 'Construcción de puente vehicular de 120 metros de luz con vigas postensadas y pilares de concreto armado cimentados sobre pilotes profundos. La obra garantiza la conectividad de 5 comunidades agrícolas con la carretera principal, resistiendo los incrementos de caudal del río.'
    },
    { 
      slug: 'hotel-cusco', 
      mainCat: 'Hotelero', 
      title: 'Hotel Boutique Cusco', 
      img: 'https://images.unsplash.com/photo-1582719478250-c89cae4dc85b', 
      status: 'En ejecución',
      cliente: 'Inversiones Hoteleras Andinas',
      ubicacion: 'Valle Sagrado, Cusco',
      descripcion: 'Ejecución de obra civil y acabados para un hotel boutique de 5 estrellas. El diseño respeta la arquitectura local incorporando muros de piedra natural, techos con vigas de madera expuestas y sistemas de calefacción radiante, fusionando lujo moderno con herencia cultural.'
    },
    { 
      slug: 'pavimentacion-av', 
      mainCat: 'Pistas y veredas', 
      title: 'Pavimentación de Av. Principal', 
      img: 'https://images.unsplash.com/photo-1545569341-9eb8b30979d9', 
      status: 'En ejecución',
      cliente: 'Municipalidad Provincial',
      ubicacion: 'Lima Norte',
      descripcion: 'Rehabilitación integral de 5 kilómetros de vía urbana. Comprende fresado, colocación de carpeta asfáltica en caliente, construcción de veredas de concreto, sardineles, señalización horizontal y vertical, y habilitación de áreas verdes y ciclovías.'
    }
  ];

  // Devuelve la ruta (slug) y los datos del proyecto (props)
  return proyectos.map((proyecto) => {
    return {
      params: { slug: proyecto.slug },
      props: { proyecto },
    };
  });
}

// 2. RECUPERAMOS LOS DATOS DEL PROYECTO ACTUAL
const { proyecto } = Astro.props;
---

<!-- 3. DISEÑO DE LA PÁGINA DE DETALLE (Mantiene tu formato corporativo) -->
<Layout title={`${proyecto.title} | Lucong SAC`}>
  <Navbar />
  
  <main class="w-full bg-white">
    
    <!-- Banner del Proyecto -->
    <section class="relative w-full h-[50vh] min-h-[400px] flex flex-col justify-end pb-16">
      <div class="absolute inset-0 w-full h-full">
        <img src={proyecto.img} alt={proyecto.title} class="w-full h-full object-cover" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
      
      <div class="relative z-10 max-w-[1200px] mx-auto px-6 md:px-8 w-full">
        <span class="inline-block bg-[#e66c37] text-white text-xs font-bold px-3 py-1 uppercase tracking-wider mb-4 rounded-sm">
          {proyecto.mainCat}
        </span>
        <h1 class="text-3xl md:text-5xl font-bold text-white tracking-tight max-w-3xl leading-tight">
          {proyecto.title}
        </h1>
      </div>
    </section>

    <!-- Contenido del Proyecto -->
    <section class="w-full py-20">
      <div class="max-w-[1200px] mx-auto px-6 md:px-8 flex flex-col md:flex-row gap-16">
        
        <!-- Columna Izquierda: Descripción -->
        <div class="w-full md:w-2/3">
          <h2 class="text-2xl font-bold text-[#333333] mb-6">Descripción de la obra</h2>
          <p class="text-slate-600 text-lg leading-relaxed">
            {proyecto.descripcion}
          </p>
          
          <!-- Botón de retorno -->
          <div class="mt-12">
            <a href="/proyectos" class="inline-flex items-center text-[#e66c37] font-semibold hover:text-[#c45a2d] transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 mr-2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
              </svg>
              Volver a proyectos
            </a>
          </div>
        </div>

        <!-- Columna Derecha: Ficha Técnica -->
        <div class="w-full md:w-1/3">
          <div class="bg-[#f8fafc] border border-slate-200 p-8 rounded-lg">
            <h3 class="text-xl font-bold text-[#333333] mb-6 border-b border-slate-200 pb-4">Ficha Técnica</h3>
            
            <ul class="space-y-6">
              <li>
                <span class="block text-sm text-slate-500 font-medium mb-1">Estado</span>
                <span class={`inline-block px-3 py-1 rounded-full text-xs font-bold ${proyecto.status === 'En ejecución' ? 'bg-orange-100 text-orange-700' : 'bg-green-100 text-green-700'}`}>
                  {proyecto.status}
                </span>
              </li>
              <li>
                <span class="block text-sm text-slate-500 font-medium mb-1">Cliente</span>
                <span class="block text-[#333333] font-semibold">{proyecto.cliente}</span>
              </li>
              <li>
                <span class="block text-sm text-slate-500 font-medium mb-1">Ubicación</span>
                <span class="block text-[#333333] font-semibold">{proyecto.ubicacion}</span>
              </li>
              <li>
                <span class="block text-sm text-slate-500 font-medium mb-1">Categoría</span>
                <span class="block text-[#333333] font-semibold">{proyecto.mainCat}</span>
              </li>
            </ul>
          </div>
        </div>

      </div>
    </section>

  </main>
  
  <Footer />
</Layout>