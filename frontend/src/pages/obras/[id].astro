---
// src/pages/obras/[id].astro — página de detalle por obra
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { obras } from '../../data/obras.js';

export function getStaticPaths() {
  return obras.map((obra) => ({
    params: { id: obra.id },
    props: { obra },
  }));
}

const { obra } = Astro.props;
const tieneDescripcion = Boolean(obra.descripcion);
---

<Layout title={`${obra.titulo} | Obras | Lucong SAC`}>
  <Navbar />
  <main>
    <!-- CABECERA + IMAGEN COMPLETA (sin recorte) -->
    <section class="w-full bg-[#333333]">
      <div class="max-w-[1200px] mx-auto px-6 md:px-8 pt-10 md:pt-14 animate-fade-in-up">
        <nav class="text-slate-300 text-[13px] md:text-[14px] font-medium mb-5 flex items-center gap-2 flex-wrap">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span class="text-slate-500">&gt;</span>
          <a href="/obras" class="hover:text-white transition-colors">Obras</a>
          <span class="text-slate-500">&gt;</span>
          <span class="text-white font-semibold">{obra.titulo}</span>
        </nav>
        <span class="text-[#e66c37] text-[12px] md:text-[13px] font-semibold uppercase tracking-wider mb-3 block">
          {obra.categoria}
        </span>
        <h1 class="text-[32px] md:text-[48px] font-bold text-white leading-[1.15] tracking-tight max-w-[800px]">
          {obra.titulo}
        </h1>
      </div>

      <!-- Imagen: fondo desenfocado + foto nítida completa encima -->
      <div class="relative w-full mt-8 md:mt-10 overflow-hidden">
        <div
          class="absolute inset-0 bg-center bg-cover scale-110 blur-2xl opacity-40"
          style={`background-image: url('${obra.img}')`}
          aria-hidden="true"
        >
        </div>
        <div class="absolute inset-0 bg-[#333333]/40" aria-hidden="true"></div>

        <div class="relative max-w-[1200px] mx-auto px-6 md:px-8 py-10 md:py-12 flex justify-center">
          <img
            src={obra.img}
            alt={obra.alt}
            class="w-auto max-w-full max-h-[72vh] object-contain rounded-lg shadow-2xl"
          />
        </div>
      </div>
    </section>

    <!-- CONTENIDO -->
    <section class="w-full bg-white py-16 md:py-20">
      <div class="max-w-[1200px] mx-auto px-6 md:px-8 grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-14">

        <!-- Descripción -->
        <div class="lg:col-span-2">
          <h2 class="text-[26px] md:text-[32px] font-semibold text-[#333333] mb-6 tracking-tight">
            Descripción de la obra
          </h2>
          {tieneDescripcion ? (
            <p class="text-slate-600 leading-relaxed text-[17px] md:text-[18px]">{obra.descripcion}</p>
          ) : (
            <p class="text-slate-400 italic leading-relaxed text-[17px]">
              Información en preparación. Pronto compartiremos los detalles de esta obra.
            </p>
          )}

          <a
            href="/obras"
            class="inline-flex items-center gap-2 mt-10 text-[#333333] font-semibold text-sm hover:text-[#e66c37] transition-colors group"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 transition-transform group-hover:-translate-x-1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
            Volver a todas las obras
          </a>
        </div>

        <!-- Ficha técnica -->
        <aside class="lg:col-span-1">
          <div class="bg-[#f8fafc] border border-slate-200 rounded-xl p-8 lg:sticky lg:top-32">
            <h3 class="text-[#333333] font-semibold text-lg mb-6 flex items-center gap-2">
              <span class="text-[#e66c37]">&gt;</span> Ficha técnica
            </h3>
            <dl class="space-y-5">
              <div>
                <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-1">Categoría</dt>
                <dd class="text-[#333333] font-semibold">{obra.categoria}</dd>
              </div>
              {obra.cliente && (
                <div>
                  <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-1">Cliente</dt>
                  <dd class="text-[#333333] font-semibold">{obra.cliente}</dd>
                </div>
              )}
              <div>
                <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-1">Ubicación</dt>
                <dd class="text-[#333333] font-semibold flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-[#e66c37]">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                  </svg>
                  {obra.ubicacion}
                </dd>
              </div>
              {obra.estado && (
                <div>
                  <dt class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-1">Estado</dt>
                  <dd>
                    <span class="inline-flex items-center gap-1.5 bg-[#e66c37]/10 text-[#c95a2a] font-semibold text-[13px] px-3 py-1 rounded-full">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#e66c37]"></span>
                      {obra.estado}
                    </span>
                  </dd>
                </div>
              )}
            </dl>
          </div>
        </aside>

      </div>
    </section>
  </main>
  <Footer />
</Layout>
