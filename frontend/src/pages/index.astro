---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AnimatedStats from '../components/react/AnimatedStats.jsx';
import ProjectCarousel from '../components/react/ProjectCarousel.jsx'; 
---

<Layout title="Inicio | Lucong SAC">
  <Navbar />
  
  <main class="w-full">
    
    <section class="relative w-full h-[calc(100vh-96px)] md:h-[calc(100vh-112px)] min-h-[400px] bg-black overflow-hidden flex flex-col">
      
      <div class="absolute inset-0 w-full h-full animate-zoom-slow">
        <div class="w-full h-full bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1541888946425-d81bb19240f5');"></div>
      </div>
      
      <div class="absolute inset-0 bg-black/20"></div>

      <div class="absolute bottom-0 right-0 z-40 flex w-full md:w-[700px] lg:w-[850px] h-[120px] md:h-[160px] shadow-2xl">
        
        <div class="w-[55%] bg-[#e66c37] px-6 md:px-10 flex flex-col justify-center text-white">
          <span class="text-[11px] md:text-[13px] font-bold flex items-center gap-2 mb-2 md:mb-3 tracking-wider uppercase">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 md:h-4 md:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            Proyecto
          </span>
          <span class="text-[14px] md:text-[18px] lg:text-[20px] font-medium leading-snug">
            Ampliación del Aeropuerto Internacional Jorge Chávez de Lima
          </span>
        </div>
        
        <a href="#" class="w-[45%] relative bg-cover bg-center flex items-center justify-center group cursor-pointer" style="background-image: url('https://images.unsplash.com/photo-1508450859948-4e04fabaa4ea');">
          <div class="absolute inset-0 bg-[#333333]/70 group-hover:bg-[#333333]/50 transition-all duration-300"></div>
          
          <div class="relative z-10 w-12 h-12 md:w-16 md:h-16 bg-white rounded-full flex items-center justify-center text-[#e66c37] shadow-lg group-hover:scale-110 transition-transform duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 md:w-7 md:h-7 ml-1">
              <path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd" />
            </svg>
          </div>
        </a>
        
      </div>
    </section>

    <section class="w-full bg-[#333333] relative z-30 overflow-hidden">
      <div class="max-w-[1200px] mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-white/10">
          
          <div class="scroll-reveal opacity-0 translate-y-16 transition-all duration-700 ease-out flex flex-col items-center justify-center text-center py-12 px-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-[#e66c37] mb-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1v1H9V7zm5 0h1v1h-1V7zm-5 4h1v1H9v-1zm5 0h1v1h-1v-1zm-5 4h1v1H9v-1zm5 0h1v1h-1v-1z" />
            </svg>
            <span class="text-white font-semibold text-[17px]">Ingeniería y construcción</span>
          </div>

          <div class="scroll-reveal opacity-0 translate-y-16 transition-all duration-700 delay-150 ease-out flex flex-col items-center justify-center text-center py-12 px-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-[#e66c37] mb-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
            <span class="text-white font-semibold text-[17px]">Más de 100 obras construidas</span>
          </div>

          <div class="scroll-reveal opacity-0 translate-y-16 transition-all duration-700 delay-300 ease-out flex flex-col items-center justify-center text-center py-12 px-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-[#e66c37] mb-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span class="text-white font-semibold text-[17px]">Política 0 accidentes</span>
          </div>

        </div>
      </div>
    </section>

    <section class="w-full bg-[#f8fafc]">
      <div class="max-w-[1200px] mx-auto px-6 md:px-8 pt-20 md:pt-28 pb-24">
        <div class="max-w-4xl mb-20"> 
          <h1 class="text-4xl md:text-[56px] font-bold text-[#333333] leading-[1.15] tracking-tight mb-8">
            Proyectos y Ejecución de Obras Civiles.
          </h1>
          <p class="text-[18px] md:text-[22px] text-slate-600 font-normal leading-relaxed">
            Construimos el futuro con solidez. Nos especializamos en la ejecución integral de proyectos de infraestructura, garantizando calidad, seguridad y cumplimiento en cada una de nuestras obras civiles a nivel nacional.
          </p>
        </div>
        <div class="w-full h-[1px] bg-slate-200 mb-16"></div>
        <div class="w-full">
          <AnimatedStats client:load /> 
        </div>
      </div>
    </section>

    <section class="w-full py-24 bg-white">
      <div class="max-w-[1200px] mx-auto px-6 md:px-8">
        
        <div class="w-full relative">
          <ProjectCarousel client:load />
        </div>
      </div>
    </section>

    <section class="w-full py-28 bg-[#333333] relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-full opacity-5 pointer-events-none" style="background-image: radial-gradient(circle at 0% 50%, #ffffff 0%, transparent 50%);"></div>
      <div class="max-w-[1200px] mx-auto px-6 md:px-8 relative z-10">
        <h2 class="text-[32px] md:text-[40px] font-bold text-white mb-16 tracking-tight">
          Nuestras principales actividades
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            { title: "Residencial", icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1v1H9V7zm5 0h1v1h-1V7zm-5 4h1v1H9v-1zm5 0h1v1h-1v-1zm-3 4h2a1 1 0 011 1v4h-4v-4a1 1 0 011-1z" },
            { title: "Industrial", icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1v1H9V7zm5 0h1v1h-1V7zm-5 4h1v1H9v-1zm5 0h1v1h-1v-1zm-5 4h1v1H9v-1zm5 0h1v1h-1v-1z" },
            { title: "Comercial", icon: "M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" },
            { title: "Infraestructura", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
            { title: "Hotelero", icon: "M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" },
            { title: "Pistas y veredas", icon: "M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" }
          ].map((act) => (
            <div class="bg-white/5 border border-white/10 p-8 rounded-sm hover:bg-[#e66c37] hover:border-[#e66c37] transition-all duration-300 group cursor-default flex items-center gap-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-[#e66c37] group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={act.icon} />
              </svg>
              <h3 class="text-xl font-semibold text-white">{act.title}</h3>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="w-full py-24 bg-[#f8fafc]">
      <div class="max-w-[1200px] mx-auto px-6 md:px-8">
        <h2 class="text-[32px] md:text-[40px] font-bold text-[#333333] mb-16 tracking-tight flex items-center gap-3">
          <span class="text-[#e66c37]">></span> Nuestros principales clientes
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-10 md:gap-16 items-center justify-items-center">
          {[
            "Anglo American", "Minera Antamina", "Minera Las Bambas", "Provías Nacional", 
            "Ministerio de Vivienda", "Consorcio Sur", "Fluor", "Bechtel"
          ].map((client) => (
            <div class="w-full h-20 flex items-center justify-center grayscale hover:grayscale-0 opacity-50 hover:opacity-100 transition-all duration-300">
              <span class="text-xl font-bold text-slate-500 text-center leading-tight">{client}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>
  
  <Footer />
</Layout>

<style>
  @keyframes zoom-slow {
    0% { transform: scale(1); }
    100% { transform: scale(1.15); }
  }
  .animate-zoom-slow {
    animation: zoom-slow 20s linear infinite alternate;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const revealElements = document.querySelectorAll('.scroll-reveal');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.remove('opacity-0', 'translate-y-16');
          entry.target.classList.add('opacity-100', 'translate-y-0');
        } else {
          entry.target.classList.remove('opacity-100', 'translate-y-0');
          entry.target.classList.add('opacity-0', 'translate-y-16');
        }
      });
    }, {
      threshold: 0.1
    });

    revealElements.forEach(el => observer.observe(el));
  });
</script>