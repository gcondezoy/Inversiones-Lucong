---
// src/pages/nosotros.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Nosotros | Lucong SAC">
	<Navbar />
	<main>
		<!-- 1. HERO NOSOTROS CON PARALLAX -->
		<section class="relative w-full h-[calc(100vh-96px)] md:h-[calc(100vh-112px)] min-h-[400px] flex flex-col justify-center bg-black overflow-hidden bg-scroll md:bg-fixed bg-center bg-cover" style="background-image: url('https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=1920&q=70');">
			
			<div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>
			
			<div class="relative z-10 w-full max-w-[1200px] mx-auto px-6 md:px-8">
				<div class="text-slate-300 text-[13px] md:text-[14px] font-medium mb-6 flex items-center gap-2 animate-slide-in-left" style="animation-delay: 0.1s;">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
					<a href="/" class="hover:text-white transition-colors">Home</a>
					<span class="text-slate-400">&gt;</span>
					<span class="text-white font-semibold">Nosotros</span>
				</div>
				<h1 class="text-[40px] md:text-[56px] font-bold text-white leading-[1.1] tracking-tight max-w-[700px] animate-slide-in-left" style="animation-delay: 0.3s;">
					Construimos<br class="hidden md:block" />
					oportunidades<br class="hidden md:block" />
					para todos de<br class="hidden md:block" />
					manera<br class="hidden md:block" />
					sostenible
				</h1>
			</div>
		</section>

		<!-- 2. NUESTRA HISTORIA (Textos Oficiales) -->
		<section class="w-full py-24 bg-white">
			<div class="max-w-[1200px] mx-auto px-6 md:px-8">
				<div class="flex flex-col lg:flex-row gap-16 items-center">
					<div class="w-full lg:w-1/2">
						<h2 class="text-[28px] md:text-[38px] font-semibold text-[#333333] mb-8 tracking-tight">Nuestra historia</h2>
						
						<p class="text-slate-600 leading-relaxed text-[17px] mb-6">
							Inversiones Lucong SAC nació en el año 2002 con una visión clara: contribuir al desarrollo del país a través de soluciones constructivas de calidad, responsabilidad y compromiso. A lo largo de más de dos décadas de trayectoria, hemos crecido de manera sostenida, ampliando nuestros servicios y consolidándonos como una empresa de alcance nacional.
						</p>
						
						<p class="text-slate-600 leading-relaxed text-[17px] mb-6">
							Hoy no solo ejecutamos obras de construcción, sino que también brindamos servicios especializados de supervisión de obras y elaboración de expedientes técnicos, acompañando a nuestros clientes en cada etapa de sus proyectos.
						</p>

						<p class="text-slate-600 leading-relaxed text-[17px]">
							Nuestra fortaleza radica en el equipo humano que nos respalda: profesionales altamente calificados, comprometidos con los más altos estándares técnicos y con la entrega oportuna de cada proyecto. Trabajamos con rigor, transparencia y vocación de servicio, valores que han guiado nuestra labor desde el primer día.
						</p>
					</div>
					<div class="w-full lg:w-1/2">
						<div class="aspect-[4/3] w-full overflow-hidden rounded-md shadow-lg">
							<img src="https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=1200&q=70" alt="Historia Lucong" class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500 opacity-90 hover:opacity-100" />
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 3. PROPÓSITO, MISIÓN, VISIÓN Y VALORES (Textos Oficiales) -->
		<section class="w-full bg-[#333333] py-24">
			<div class="max-w-[1200px] mx-auto px-6 md:px-8">
				<h2 class="text-[28px] md:text-[38px] font-semibold text-white mb-16 tracking-tight flex items-center gap-3">
					<span class="text-[#e66c37]">></span> Propósito, Misión, Visión y Valores
				</h2>
				
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
					
					<!-- Propósito -->
					<div class="bg-white/5 border border-white/10 p-8 rounded-md hover:bg-[#e66c37] hover:border-[#e66c37] transition-all duration-300 group">
						<div class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center text-[#e66c37] group-hover:text-white group-hover:bg-white/20 transition-colors mb-6">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15.042 21.672 13.684 16.6m0 0-2.51 2.225.569-9.47 5.227 7.917-3.286-.672Zm-7.518-.267A8.25 8.25 0 1 1 20.25 10.5M8.288 14.212A5.25 5.25 0 1 1 17.25 10.5" /></svg>
						</div>
						<h3 class="text-xl font-semibold text-white mb-4">Propósito</h3>
						<p class="text-slate-300 font-light leading-relaxed text-[15px] group-hover:text-white/90">
							Construir infraestructura de calidad que contribuya al desarrollo del país, brindando soluciones integrales en construcción, supervisión y expedientes técnicos, con profesionalismo, transparencia y compromiso en cada proyecto.
						</p>
					</div>

					<!-- Misión -->
					<div class="bg-white/5 border border-white/10 p-8 rounded-md hover:bg-[#e66c37] hover:border-[#e66c37] transition-all duration-300 group">
						<div class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center text-[#e66c37] group-hover:text-white group-hover:bg-white/20 transition-colors mb-6">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>
						</div>
						<h3 class="text-xl font-semibold text-white mb-4">Misión</h3>
						<p class="text-slate-300 font-light leading-relaxed text-[15px] group-hover:text-white/90">
							Satisfacer las necesidades de nuestros clientes excediendo sus expectativas, proporcionando servicios de calidad, generando un ambiente seguro para el trabajo, minimizando el impacto ambiental y trabajando con transparencia.
						</p>
					</div>

					<!-- Visión -->
					<div class="bg-white/5 border border-white/10 p-8 rounded-md hover:bg-[#e66c37] hover:border-[#e66c37] transition-all duration-300 group">
						<div class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center text-[#e66c37] group-hover:text-white group-hover:bg-white/20 transition-colors mb-6">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
						</div>
						<h3 class="text-xl font-semibold text-white mb-4">Visión</h3>
						<p class="text-slate-300 font-light leading-relaxed text-[15px] group-hover:text-white/90">
							Estar entre las empresas más grandes del Perú en el sector construcción e inmobiliario, contribuyendo al éxito y desarrollo del país.
						</p>
					</div>

					<!-- Valores -->
					<div class="bg-white/5 border border-white/10 p-8 rounded-md hover:bg-[#e66c37] hover:border-[#e66c37] transition-all duration-300 group">
						<div class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center text-[#e66c37] group-hover:text-white group-hover:bg-white/20 transition-colors mb-6">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" /></svg>
						</div>
						<h3 class="text-xl font-semibold text-white mb-4">Valores</h3>
						<div class="text-slate-300 font-light leading-snug text-[13px] flex flex-col gap-3 group-hover:text-white/90">
							<p><strong class="text-white font-medium">Disciplina:</strong> Para realizar un excelente desempeño y superar los niveles de productividad.</p>
							<p><strong class="text-white font-medium">Armonía:</strong> En todas nuestras áreas, logrando tener un excelente ambiente laboral.</p>
							<p><strong class="text-white font-medium">Eficiencia:</strong> En nuestros procesos para utilizar apropiadamente los recursos y lograr los objetivos.</p>
							<p><strong class="text-white font-medium">Responsabilidad Social:</strong> Respetamos el medio ambiente y contribuimos con el desarrollo de las comunidades.</p>
						</div>
					</div>

				</div>
			</div>
		</section>

		<!-- 4. CERTIFICACIONES (A la espera de los ISO oficiales) -->
		<section class="w-full bg-[#f8fafc] py-24">
			<div class="max-w-[1200px] mx-auto px-6 md:px-8">
				<h2 class="text-[28px] md:text-[38px] font-semibold text-[#333333] mb-12 tracking-tight flex items-center gap-3">
					<span class="text-[#e66c37]">></span> Nuestras Certificaciones
				</h2>
				
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
					
					<!-- ISO 9001 -->
					<div class="bg-white rounded-xl p-8 border border-slate-200 shadow-sm hover:shadow-xl transition-shadow text-center flex flex-col items-center group">
						<img src="/certificaciones/iso-9001-gestion-calidad.png" alt="Certificación ISO 9001 - Sistema de Gestión de la Calidad de Inversiones Lucong" loading="lazy" class="w-28 h-28 object-contain mb-6" />
						<h3 class="text-2xl font-bold text-[#333333] mb-2">ISO 9001</h3>
						<div class="w-8 h-1 bg-[#e66c37] mx-auto mb-4"></div>
						<p class="text-slate-500 text-[15px] leading-snug">Sistema de Gestión de la Calidad</p>
					</div>

					<!-- ISO 14001 -->
					<div class="bg-white rounded-xl p-8 border border-slate-200 shadow-sm hover:shadow-xl transition-shadow text-center flex flex-col items-center group">
						<img src="/certificaciones/iso-14001-gestion-ambiental.png" alt="Certificación ISO 14001 - Sistema de Gestión Ambiental de Inversiones Lucong" loading="lazy" class="w-28 h-28 object-contain mb-6" />
						<h3 class="text-2xl font-bold text-[#333333] mb-2">ISO 14001</h3>
						<div class="w-8 h-1 bg-[#e66c37] mx-auto mb-4"></div>
						<p class="text-slate-500 text-[15px] leading-snug">Sistema de Gestión Ambiental</p>
					</div>

					<!-- ISO 45001 -->
					<div class="bg-white rounded-xl p-8 border border-slate-200 shadow-sm hover:shadow-xl transition-shadow text-center flex flex-col items-center group">
						<img src="/certificaciones/iso-45001-seguridad-salud-trabajo.png" alt="Certificación ISO 45001 - Sistema de Gestión de Seguridad y Salud en el Trabajo de Inversiones Lucong" loading="lazy" class="w-28 h-28 object-contain mb-6" />
						<h3 class="text-2xl font-bold text-[#333333] mb-2">ISO 45001</h3>
						<div class="w-8 h-1 bg-[#e66c37] mx-auto mb-4"></div>
						<p class="text-slate-500 text-[15px] leading-snug">Sist. de Gestión de Seguridad y Salud en el Trabajo</p>
					</div>

					<!-- ISO 37001 -->
					<div class="bg-white rounded-xl p-8 border border-slate-200 shadow-sm hover:shadow-xl transition-shadow text-center flex flex-col items-center group">
						<img src="/certificaciones/iso-37001-antisoborno.png" alt="Certificación ISO 37001 - Sistema de Gestión Antisoborno de Inversiones Lucong" loading="lazy" class="w-28 h-28 object-contain mb-6" />
						<h3 class="text-2xl font-bold text-[#333333] mb-2">ISO 37001</h3>
						<div class="w-8 h-1 bg-[#e66c37] mx-auto mb-4"></div>
						<p class="text-slate-500 text-[15px] leading-snug">Sistema de Gestión Antisoborno</p>
					</div>

				</div>
			</div>
		</section>

	</main>
	<Footer />
</Layout>