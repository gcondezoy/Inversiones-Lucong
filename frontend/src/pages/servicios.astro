---
// src/pages/servicios.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const servicios = [
  {
    title: "Obras Civiles",
    desc: "Desarrollamos proyectos de infraestructura pesada, incluyendo cimentaciones profundas, muros de contención y sistemas de drenaje, garantizando la estabilidad y durabilidad de cada estructura en todo momento.",
    img: "https://images.unsplash.com/photo-1541888946425-d81bb19240f5",
    reverse: false
  },
  {
    title: "Movimiento de Tierras",
    desc: "Contamos con maquinaria especializada para la excavación, nivelación y compactación de terrenos. Preparamos el área de trabajo con precisión topográfica para proyectos industriales y mineros de alta complejidad.",
    img: "https://images.unsplash.com/photo-1578328819058-b69f3a3b0f6b",
    reverse: true
  },
  {
    title: "Edificaciones y Estructuras",
    desc: "Construcción integral de naves industriales, campamentos y centros corporativos. Gestionamos desde la estructura metálica o de concreto hasta los acabados finales, respetando los plazos de entrega.",
    img: "https://images.unsplash.com/photo-1508450859948-4e04fabaa4ea",
    reverse: false
  }
];
---

<Layout title="Servicios | Lucong SAC">
	<Navbar />
	<main>
		<!-- HERO SERVICIOS AL RAS DE PANTALLA -->
		<section class="relative w-full h-[calc(100vh-96px)] md:h-[calc(100vh-112px)] min-h-[400px] flex flex-col justify-center bg-black overflow-hidden">
			<div class="absolute inset-0 w-full h-full">
				<img src="https://images.unsplash.com/photo-1503387762-592deb58ef4e" alt="Fondo Servicios" class="w-full h-full object-cover" />
			</div>
			<div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>
			
			<div class="relative z-10 w-full max-w-[1200px] mx-auto px-6 md:px-8">
				<div class="text-slate-300 text-[13px] md:text-[14px] font-medium mb-6 flex items-center gap-2 animate-slide-in-left" style="animation-delay: 0.1s;">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
					<a href="/" class="hover:text-white transition-colors">Home</a>
					<span class="text-slate-400">&gt;</span>
					<span class="text-white font-semibold">Servicios</span>
				</div>
				<!-- CORRECCIÓN: text-[54px] y font-bold -->
				<h1 class="text-[38px] md:text-[54px] font-bold text-white leading-[1.2] tracking-tight animate-slide-in-left" style="animation-delay: 0.3s;">
					Servicios
				</h1>
			</div>
		</section>

		<!-- Lista de Servicios (ZigZag corporativo) -->
		<section class="py-24 bg-white">
			<div class="max-w-[1400px] mx-auto px-6">
				{servicios.map((s, i) => (
					<div class={`flex flex-col ${s.reverse ? 'lg:flex-row-reverse' : 'lg:flex-row'} items-center gap-16 mb-24 last:mb-0 animate-fade-in-up`} style={`animation-delay: ${i * 0.1}s;`}>
						<div class="w-full lg:w-1/2">
							<div class="relative aspect-[4/3] shadow-xl overflow-hidden rounded-md group">
								<img src={s.img} alt={s.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
								<div class="absolute top-0 left-0 w-2 h-full bg-[#e66c37]"></div>
							</div>
						</div>
						<div class="w-full lg:w-1/2 lg:px-8">
							<h2 class="text-4xl text-[#333333] font-bold mb-6">{s.title}</h2>
							<p class="text-lg text-slate-600 font-light leading-relaxed mb-8">{s.desc}</p>
							<a href="#" class="inline-block border-2 border-[#333333] text-[#333333] hover:bg-[#333333] hover:text-white font-bold px-8 py-3 rounded-full transition-colors shadow-sm">
								Cotizar Servicio
							</a>
						</div>
					</div>
				))}
			</div>
		</section>
	</main>
	<Footer />
</Layout>