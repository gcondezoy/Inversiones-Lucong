---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="bg-white text-slate-800 font-sans antialiased m-0 p-0 overflow-x-hidden">
		<slot />

		<script is:inline>
			(function () {
				const layers = document.querySelectorAll('[data-parallax] .parallax-bg');
				if (!layers.length) return;
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

				const speed = 0.12;
				let ticking = false;

				function update() {
					for (const el of layers) {
						const rect = el.parentElement.getBoundingClientRect();
						if (rect.bottom < 0 || rect.top > window.innerHeight) continue;
						el.style.transform = 'translate3d(0,' + (-rect.top * speed).toFixed(1) + 'px,0)';
					}
					ticking = false;
				}

				function onScroll() {
					if (!ticking) {
						ticking = true;
						requestAnimationFrame(update);
					}
				}

				window.addEventListener('scroll', onScroll, { passive: true });
				window.addEventListener('resize', onScroll, { passive: true });
				update();
			})();
		</script>
	</body>
</html>