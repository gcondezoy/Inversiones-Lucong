---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'Inversiones Lucong SAC — Ejecución integral de obras civiles en el Perú: edificaciones, industria e infraestructura, con más de 20 años de trayectoria.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon-lucong.png" />
		<link rel="apple-touch-icon" href="/favicon-lucong.png" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="google-site-verification" content="v6kepsF0NdDEE_-kRyT2BEEFBaIVpCDcFu5sER2mllA" />
		<title>{title}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL('/logo-lucong.png', Astro.site)} />
		<meta property="og:locale" content="es_PE" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
	</head>
	<body class="bg-white text-slate-800 font-sans antialiased m-0 p-0 overflow-x-hidden">
		<slot />

		<script is:inline>
			(function () {
				const layers = document.querySelectorAll('[data-parallax] .parallax-bg');
				if (!layers.length) return;
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

				const speed = 0.12;
				let ticking = false;

				function update() {
					for (const el of layers) {
						const rect = el.parentElement.getBoundingClientRect();
						if (rect.bottom < 0 || rect.top > window.innerHeight) continue;
						el.style.transform = 'translate3d(0,' + (-rect.top * speed).toFixed(1) + 'px,0)';
					}
					ticking = false;
				}

				function onScroll() {
					if (!ticking) {
						ticking = true;
						requestAnimationFrame(update);
					}
				}

				window.addEventListener('scroll', onScroll, { passive: true });
				window.addEventListener('resize', onScroll, { passive: true });
				update();
			})();
		</script>
	</body>
</html>